{
  "manifest_version": 3,
  "name": "GSB LifeMode",
  "short_name": "LifeMode",
  "version": "0.5.2",
  "description": "Turn confusing pages and forms into a calm checklist and one clear next step.",
  "action": {
    "default_title": "Open LifeMode"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "css": ["src/lifemode.css"],
      "run_at": "document_idle"
    }
  ]
}
